# Audit: only scripts and summary reports are versioned.
# Run outputs live in ../re_audit_archive/audit/.
audit/*
!audit/scripts/
!audit/reports/

# Desktop GUI build & design workspace
.stitch/
.impeccable/
.webview-cache/
*.log
frontend/node_modules/
frontend/dist/
dist/
build/
*.spec
!Reper.spec

