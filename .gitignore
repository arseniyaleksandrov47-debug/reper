# Secrets and local state
.local-secrets/
.local-cache/
.env
*.key

# Separate local service with its own keys and binaries
AIStudio2API/

# Python
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/

# Working city databases (regenerated by collection)
data/*.db
data/*.db-shm
data/*.db-wal
*.sqlite3
*.sqlite3-shm
